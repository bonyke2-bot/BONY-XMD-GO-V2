  "logo": "https://files.catbox.moe/bkuj17.jpg",
  "success_url": "/",
  "env": {
    "SESSION": {
      "description": "Add your BONY-XMD session id here",
      "required": true
    },
    "OWNER_NUMBER": {
      "description": "Put your phone number without + or spaces. Ex: 2547XXXXXXXX",
      "required": true
